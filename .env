# Entity Sports API Credentials

# Entity Sports লাইভ পুশ টোকেন (WebSocket)
ES_PUSH_TOKEN=fab8ad1ab131b918781ec118e8cad09e

# Entity Sports REST টোকেন ও বেস URL (fixture তালিকার জন্য)
ES_REST_TOKEN=ec471071441bb2ac538a0ff901abd249
ES_REST_BASE=https://restapi.entitysport.com/v2


# প্রতিটি বেটের স্টেক। না দিলে 15। প্রথমে ছোট অঙ্ক দিয়ে টেস্ট করুন।
